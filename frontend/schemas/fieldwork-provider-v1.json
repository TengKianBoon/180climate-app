{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schemas/fieldwork-provider-v1.json",
  "title": "180Climate Fieldwork provider enrolment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invitation_code", "idempotency_key", "name", "contact_kind", "contact", "locale",
    "invitation_source", "original_text", "role_title", "services", "service_area", "travel",
    "availability", "experience", "languages", "exclusions", "matching_consent",
    "contact_process_consent", "terms_accepted", "privacy_acknowledged", "lawful_use_attested",
    "adult_attested", "competent_scope_attested", "no_payment_details"
  ],
  "properties": {
    "invitation_code": {"type": "string", "minLength": 4, "maxLength": 160, "writeOnly": true},
    "idempotency_key": {"type": "string", "minLength": 12, "maxLength": 100},
    "name": {"type": "string", "minLength": 2, "maxLength": 120},
    "contact_kind": {"enum": ["email", "whatsapp"]},
    "contact": {"type": "string", "minLength": 7, "maxLength": 254, "writeOnly": true},
    "locale": {"enum": ["en", "id"]},
    "invitation_source": {"type": "string", "minLength": 2, "maxLength": 200},
    "original_text": {"type": "string", "minLength": 20, "maxLength": 4000},
    "role_title": {"type": "string", "minLength": 2, "maxLength": 160},
    "services": {"type": "string", "minLength": 5, "maxLength": 1200},
    "service_area": {"type": "string", "minLength": 2, "maxLength": 300},
    "travel": {"type": "string", "minLength": 2, "maxLength": 300},
    "availability": {"type": "string", "minLength": 2, "maxLength": 300},
    "experience": {"type": "string", "minLength": 10, "maxLength": 1600},
    "credentials": {"type": "string", "maxLength": 1200},
    "languages": {"type": "string", "minLength": 2, "maxLength": 300},
    "equipment": {"type": "string", "maxLength": 800},
    "exclusions": {"type": "string", "minLength": 2, "maxLength": 1000},
    "matching_consent": {"type": "boolean", "const": true},
    "contact_process_consent": {"type": "boolean", "const": true},
    "terms_accepted": {"type": "boolean", "const": true},
    "privacy_acknowledged": {"type": "boolean", "const": true},
    "lawful_use_attested": {"type": "boolean", "const": true},
    "adult_attested": {"type": "boolean", "const": true},
    "competent_scope_attested": {"type": "boolean", "const": true},
    "no_payment_details": {"type": "boolean", "const": true}
  }
}
