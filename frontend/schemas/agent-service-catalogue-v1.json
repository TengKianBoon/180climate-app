{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/schemas/agent-service-catalogue-v1.json",
  "title": "180Climate agent service catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogue_version", "updated_at", "provider", "discovery", "agent_policy", "services"],
  "properties": {
    "$schema": {"type": "string"},
    "catalogue_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "updated_at": {"type": "string", "format": "date"},
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["legal_name", "website"],
      "properties": {"legal_name": {"type": "string"}, "website": {"type": "string", "format": "uri"}}
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_url", "openapi_url", "human_docs_url"],
      "properties": {
        "canonical_url": {"type": "string"},
        "openapi_url": {"type": "string"},
        "human_docs_url": {"type": "string"}
      }
    },
    "agent_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorised_agent_only", "meaning", "annotations_are_hints", "approval_rule", "never_autonomous"],
      "properties": {
        "authorised_agent_only": {"const": true},
        "meaning": {"type": "string", "minLength": 20},
        "annotations_are_hints": {"const": true},
        "approval_rule": {"type": "string", "minLength": 40},
        "never_autonomous": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "services": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/service"}
    }
  },
  "$defs": {
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readOnlyHint", "destructiveHint", "idempotentHint", "openWorldHint"],
      "properties": {
        "readOnlyHint": {"type": "boolean"},
        "destructiveHint": {"type": "boolean"},
        "idempotentHint": {"type": "boolean"},
        "openWorldHint": {"type": "boolean"}
      }
    },
    "action": {
      "type": "object",
      "required": ["action_id", "transport", "url", "requires_immediate_user_approval", "side_effects", "annotations"],
      "properties": {
        "action_id": {"type": "string"},
        "transport": {"enum": ["openapi", "web"]},
        "operation_id": {"type": "string"},
        "method": {"enum": ["GET", "POST"]},
        "url": {"type": "string"},
        "content_type": {"type": "string"},
        "input_schema_url": {"type": "string"},
        "output_schema_url": {"type": "string"},
        "availability": {"type": "string"},
        "requires_immediate_user_approval": {"type": "boolean"},
        "side_effects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "annotations": {"$ref": "#/$defs/annotations"}
      }
    },
    "agent_procurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["readiness", "summary", "actions", "blocked_autonomous_actions"],
      "properties": {
        "readiness": {"type": "string"},
        "summary": {"type": "string", "minLength": 30},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}},
        "blocked_autonomous_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "service": {
      "type": "object",
      "required": [
        "service_id", "version", "name", "description", "status", "regions", "eligibility",
        "required_inputs", "input_schema_url", "output_schema_url", "limitations", "approval_points",
        "price_status", "terms_url", "privacy_url", "agent_procurement", "updated_at"
      ],
      "properties": {
        "service_id": {"type": "string"},
        "version": {"type": "string"},
        "name": {"type": "string"},
        "description": {"type": "string"},
        "status": {"type": "string"},
        "intake_mode": {"type": "string"},
        "intake_url": {"type": "string"},
        "regions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "eligibility": {"type": "array", "items": {"type": "string"}},
        "required_inputs": {"type": "array", "items": {"type": "string"}},
        "input_schema_url": {"type": "string"},
        "provider_input_schema_url": {"type": "string"},
        "output_schema_url": {"type": "string"},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "approval_points": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "price_status": {"type": "string"},
        "terms_url": {"type": "string"},
        "privacy_url": {"type": "string"},
        "agent_procurement": {"$ref": "#/$defs/agent_procurement"},
        "updated_at": {"type": "string", "format": "date"}
      }
    }
  }
}
