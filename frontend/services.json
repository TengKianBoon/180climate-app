      ],
      "approval_points": ["Use of authorised land and contact data", "Detailed report request", "Professional, financial or investment reliance"],
      "price_status": "free_early_screen",
      "terms_url": "https://www.180climate.net/",
      "privacy_url": "https://www.180climate.net/",
      "agent_procurement": {
        "readiness": "guarded_screening",
        "summary": "Machine-callable for the declared REDD, IFM and peat screening routes. The 'other' route can create an external lead and needs immediate user approval.",
        "actions": [
          {
            "action_id": "screen_pre_feasibility",
            "transport": "openapi",
            "operation_id": "screenCarbonPreFeasibility",
            "method": "POST",
            "url": "/api/carbon",
            "content_type": "application/json",
            "input_schema_url": "/schemas/carbon-pre-fs-input-v1.json",
            "output_schema_url": "/schemas/carbon-pre-fs-output-v1.json",
            "requires_immediate_user_approval": true,
            "side_effects": ["processes_contact_data", "processes_land_geometry", "may_query_external_datasets", "other_route_may_email_180climate"],
            "annotations": {
              "readOnlyHint": false,
              "destructiveHint": false,
              "idempotentHint": false,
              "openWorldHint": true
            }
          }
        ],
        "blocked_autonomous_actions": ["bankable study", "valuation", "investment recommendation", "registry submission", "contract", "payment"]
      },
